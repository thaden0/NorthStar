// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==================== AUTH & USERS ====================

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  hashedPassword    String
  name              String
  avatar            String?
  aiInstructions    String?   @db.Text  // Custom instructions included in AI prompts
  emailVerified     Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  roles             UserRole[]
  sessions          Session[]
  logs              Log[]
  notifications     Notification[]
  scheduledTasks    ScheduledTask[]
  clients           Client[]
  timeEntries       TimeEntry[]
  invoices          Invoice[]
  invoiceSettings   InvoiceSettings?
  googleAccounts    GoogleAccount[]
  imapAccounts      ImapAccount[]
  
  // Social relations
  socialAccounts    SocialAccount[]
  friendRequestsSent     Friendship[]  @relation("FriendshipRequester")
  friendRequestsReceived Friendship[]  @relation("FriendshipAddressee")
  messagesSent      Message[]  @relation("MessageSender")
  messagesReceived  Message[]  @relation("MessageReceiver")
  userStatus        UserStatus?
  
  // Job Search relations
  jobSearches       JobSearch[]
  resumes           Resume[]
  coverLetters      CoverLetter[]
  jobApplications   JobApplication[]

  @@index([email])
}

// Google Account connections (supports multiple accounts per user)
model GoogleAccount {
  id              String    @id @default(cuid())
  userId          String
  googleEmail     String    // The Google account email
  displayName     String?   // User's display name from Google
  isDefault       Boolean   @default(false)  // Primary account for sending
  isActive        Boolean   @default(true)
  lastSyncAt      DateTime?
  syncError       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([userId, googleEmail])  // One user can't connect same Google account twice
  @@index([userId])
  @@index([googleEmail])
}

// IMAP Email Account connections (for non-Google email providers)
model ImapAccount {
  id              String    @id @default(cuid())
  userId          String
  email           String    // The email address
  displayName     String?
  imapHost        String    // IMAP server host
  imapPort        Int       @default(993)
  imapSecure      Boolean   @default(true)
  smtpHost        String    // SMTP server for sending
  smtpPort        Int       @default(587)
  smtpSecure      Boolean   @default(true)
  username        String    // Login username (usually email)
  password        String    // Encrypted password
  isDefault       Boolean   @default(false)
  isActive        Boolean   @default(true)
  lastSyncAt      DateTime?
  syncError       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([userId, email])
  @@index([userId])
}

model Role {
  id          String     @id @default(cuid())
  name        String     @unique
  description String?
  createdAt   DateTime   @default(now())

  // Relations
  users       UserRole[]
}

model UserRole {
  id        String   @id @default(cuid())
  userId    String
  roleId    String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ==================== PORTFOLIO ====================

model PortfolioSettings {
  id              String   @id @default(cuid())
  heroTitle       String   @default("Leonard Waugh")
  heroSubtitle    String   @default("Full-Stack Developer, DevOps Engineer, Application Architect, Mobile Developer")
  heroImage       String?
  aboutTitle      String   @default("About me")
  aboutText       String   @db.Text
  aboutImage      String?
  name            String   @default("Leonard Waugh")
  profile         String   @default("Senior Full-Stack Developer")
  email           String   @default("leonard.l.waugh@gmail.com")
  location        String   @default("Tilbury, Ontario, Canada")
  linkedIn        String?
  github          String?
  resumeSummary   String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Skill {
  id          String   @id @default(cuid())
  name        String
  category    String   // languages, frameworks, tools
  icon        String?  // devicon class or react-icons name
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
}

model Education {
  id          String   @id @default(cuid())
  degree      String
  institution String
  startYear   String
  endYear     String?
  description String?  @db.Text
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Experience {
  id          String   @id @default(cuid())
  title       String
  company     String
  location    String?
  startDate   String
  endDate     String?
  description String?  @db.Text
  highlights  String[] // Array of bullet points
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Service {
  id          String   @id @default(cuid())
  title       String
  description String   @db.Text
  icon        String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Project {
  id          String   @id @default(cuid())
  title       String
  description String   @db.Text
  image       String?
  technologies String[] // Array of tech tags
  liveUrl     String?
  sourceUrl   String?
  featured    Boolean  @default(false)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model FAQ {
  id       String   @id @default(cuid())
  question String
  answer   String   @db.Text
  order    Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==================== FILES ====================

model File {
  id          String   @id @default(cuid())
  name        String
  key         String   @unique
  url         String
  size        Int
  type        String
  uploadedBy  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([uploadedBy])
}

// ==================== SITE SETTINGS ====================

// SiteSetting table removed - replaced by SiteSettings singleton model

// ==================== LOGS ====================

model Log {
  id        String   @id @default(cuid())
  level     String   // info, warn, error
  message   String   @db.Text
  metadata  Json?
  userId    String?
  createdAt DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([level])
  @@index([userId])
  @@index([createdAt])
}

// ==================== AI INSIGHTS ====================

model AIInsight {
  id        String   @id @default(cuid())
  title     String
  content   String   @db.Text
  type      String   // analytics, recommendation, alert
  status    String   @default("unread") // unread, read, archived
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([status])
}

// ==================== NOTIFICATIONS ====================

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String   // cron_result, cron_error, system, alert, info
  title     String
  message   String   @db.Text
  data      Json?    // Additional structured data (jobId, executionId, etc.)
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([createdAt])
}

// ==================== SCHEDULED TASKS ====================

model ScheduledTask {
  id               String    @id @default(cuid())
  userId           String
  name             String
  description      String?
  prompt           String    @db.Text
  scheduleType     String    // cron, once, recurring
  cronExpression   String?
  scheduledAt      DateTime?
  recurringPattern String?   // daily, weekly, monthly, etc.
  recurringDay     Int?
  recurringTime    String?
  timezone         String    @default("UTC")
  enabled          Boolean   @default(true)
  lastRunAt        DateTime?
  nextRunAt        DateTime?
  runCount         Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([enabled])
}

// ==================== TIME TRACKING ====================

model Client {
  id          String          @id @default(cuid())
  userId      String
  name        String
  email       String?
  phone       String?
  address     String?         @db.Text
  notes       String?         @db.Text
  hourlyRate  Float           @default(0)
  color       String          @default("#3b82f6") // Hex color for UI
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  projects    ClientProject[]
  timeEntries TimeEntry[]

  @@index([userId])
  @@index([isActive])
}

model ClientProject {
  id          String      @id @default(cuid())
  clientId    String
  name        String
  description String?     @db.Text
  hourlyRate  Float?      // Override client rate if set
  color       String      @default("#3b82f6") // Project color for time blocks
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  client      Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  timeEntries TimeEntry[]

  @@index([clientId])
  @@index([isActive])
}

model TimeEntry {
  id          String         @id @default(cuid())
  userId      String
  clientId    String?
  projectId   String?
  startTimeUtc DateTime      // Stored in UTC
  endTimeUtc   DateTime      // Stored in UTC
  description String?        @db.Text
  billable    Boolean        @default(true)
  invoiced    Boolean        @default(false)
  invoiceId   String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  client      Client?        @relation(fields: [clientId], references: [id], onDelete: SetNull)
  project     ClientProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  invoice     Invoice?       @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([clientId])
  @@index([projectId])
  @@index([startTimeUtc])
  @@index([invoiced])
}

model Invoice {
  id              String      @id @default(cuid())
  userId          String
  invoiceNumber   String
  clientId        String?
  clientName      String      // Snapshot of client name at invoice time
  clientEmail     String?
  clientAddress   String?     @db.Text
  issueDate       DateTime
  dueDate         DateTime?
  subtotal        Float
  taxRate         Float       @default(0)
  taxAmount       Float       @default(0)
  total           Float
  notes           String?     @db.Text
  terms           String?     @db.Text
  status          String      @default("draft") // draft, sent, paid, overdue
  paidAt          DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  timeEntries     TimeEntry[]
  lineItems       InvoiceLineItem[]

  @@unique([userId, invoiceNumber])
  @@index([userId])
  @@index([clientId])
  @@index([status])
}

model InvoiceLineItem {
  id          String   @id @default(cuid())
  invoiceId   String
  description String
  quantity    Float    // Hours or units
  rate        Float
  amount      Float
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model InvoiceSettings {
  id                String   @id @default(cuid())
  userId            String   @unique
  businessName      String?
  businessEmail     String?
  businessPhone     String?
  businessAddress   String?  @db.Text
  businessWebsite   String?  // Company website
  logoUrl           String?  // Small logo for header
  letterheadUrl     String?  // Full-width letterhead image
  accentColor       String?  @default("#3b82f6") // Brand color for invoice
  defaultTaxRate    Float    @default(0)
  defaultPaymentTerms String? @db.Text
  defaultNotes      String?  @db.Text
  invoicePrefix     String   @default("INV-")
  nextInvoiceNumber Int      @default(1)
  bankName          String?  // For payment info section
  bankAccountNumber String?
  bankRoutingNumber String?
  paypalEmail       String?
  venmoHandle       String?
  footerText        String?  @db.Text // Custom footer message
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ==================== SITE SETTINGS ====================
// Singleton table - only one row should exist

model SiteSettings {
  id                    String   @id @default("singleton")
  
  // General Settings
  siteName              String   @default("North Star")
  siteTagline           String   @default("Personal Dashboard & Portfolio")
  siteUrl               String   @default("http://localhost:3000")
  timezone              String   @default("America/Toronto")
  dateFormat            String   @default("MMM dd, yyyy")
  timeFormat            String   @default("h:mm a")
  language              String   @default("en")
  
  // Appearance
  theme                 String   @default("dark")  // dark, light, system
  accentColor           String   @default("#3B82F6")
  enableAnimations      Boolean  @default(true)
  sidebarCollapsed      Boolean  @default(false)
  compactMode           Boolean  @default(false)
  
  // Security Settings
  sessionDurationDays   Int      @default(30)
  requireStrongPassword Boolean  @default(true)
  maxLoginAttempts      Int      @default(5)
  lockoutDurationMins   Int      @default(15)
  enable2FA             Boolean  @default(false)
  
  // Notification Settings
  enableEmailNotifications  Boolean @default(true)
  enablePushNotifications   Boolean @default(false)
  notificationDigestFreq    String  @default("instant") // instant, daily, weekly
  quietHoursStart           String? // e.g., "22:00"
  quietHoursEnd             String? // e.g., "08:00"
  
  // AI Settings
  aiEnabled             Boolean  @default(true)
  aiDefaultModel        String   @default("qwen2.5:14b")
  aiMaxTokens           Int      @default(4096)
  aiTemperature         Float    @default(0.7)
  aiMemoryEnabled       Boolean  @default(true)
  aiProactiveMemory     Boolean  @default(true)
  
  // Dashboard Settings
  dashboardLayout       String   @default("default") // default, compact, expanded
  showWelcomeMessage    Boolean  @default(true)
  defaultDashboardTab   String   @default("overview")
  enableQuickActions    Boolean  @default(true)
  
  // Portfolio Settings
  portfolioEnabled      Boolean  @default(true)
  portfolioPublic       Boolean  @default(true)
  showContactForm       Boolean  @default(true)
  enableBlogComments    Boolean  @default(false)
  
  // Time Tracking Settings
  timeTrackingEnabled   Boolean  @default(true)
  defaultBillableRate   Float    @default(0)
  trackingReminderTime  String?  // e.g., "17:00"
  autoStopTimerHours    Int      @default(8)
  roundTimeTo           Int      @default(15) // minutes
  
  // Integration Settings
  googleCalendarSync    Boolean  @default(false)
  googleContactsSync    Boolean  @default(false)
  googleEmailSync       Boolean  @default(true)
  emailSyncIntervalMins Int      @default(10)     // How often to sync emails (minutes)
  calendarSyncIntervalMins Int   @default(15)     // How often to sync calendar events
  contactsSyncIntervalMins Int   @default(60)     // How often to sync contacts
  slackIntegration      Boolean  @default(false)
  webhooksEnabled       Boolean  @default(false)
  
  // Email Settings (SMTP)
  smtpEnabled           Boolean  @default(false)
  smtpHost              String?
  smtpPort              Int      @default(587)
  smtpUser              String?
  smtpPassword          String?
  smtpFromEmail         String?
  smtpFromName          String?
  smtpSecure            Boolean  @default(true)
  
  // Maintenance
  maintenanceMode       Boolean  @default(false)
  maintenanceMessage    String?  @db.Text
  debugMode             Boolean  @default(false)
  logRetentionDays      Int      @default(30)
  
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

// ==================== SOCIAL SYSTEM ====================

// Connected social media accounts (Facebook, LinkedIn, Discord, etc.)
model SocialAccount {
  id              String    @id @default(cuid())
  userId          String
  provider        String    // 'facebook', 'linkedin', 'discord', 'twitter', 'github'
  providerId      String    // The ID from the social platform
  accessToken     String?   @db.Text
  refreshToken    String?   @db.Text
  tokenExpiry     DateTime?
  username        String?   // Display name on that platform
  profileUrl      String?   // Link to profile
  avatarUrl       String?   // Profile picture from that platform
  isActive        Boolean   @default(true)
  lastSyncAt      DateTime?
  syncError       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])  // One account per provider per user
  @@unique([provider, providerId])  // Provider ID must be unique per platform
  @@index([userId])
  @@index([provider])
}

// Friendship between North Star users
model Friendship {
  id          String    @id @default(cuid())
  requesterId String    // User who sent the request
  addresseeId String    // User who received the request
  status      String    @default("pending")  // 'pending', 'accepted', 'declined', 'blocked'
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  acceptedAt  DateTime?

  requester   User      @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee   User      @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])  // Prevent duplicate friend requests
  @@index([requesterId])
  @@index([addresseeId])
  @@index([status])
}

// Chat messages between users
model Message {
  id          String    @id @default(cuid())
  senderId    String
  receiverId  String
  content     String    @db.Text
  isRead      Boolean   @default(false)
  readAt      DateTime?
  isInternal  Boolean   @default(true)  // true = North Star chat, false = external platform
  platform    String?   // 'internal', 'facebook', 'discord', etc.
  externalId  String?   // Message ID on external platform
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  sender      User      @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver    User      @relation("MessageReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([senderId])
  @@index([receiverId])
  @@index([createdAt])
  @@index([isRead])
}

// User online status / presence
model UserStatus {
  id            String    @id @default(cuid())
  userId        String    @unique
  isOnline      Boolean   @default(false)
  lastSeenAt    DateTime  @default(now())
  currentStatus String    @default("available")  // 'available', 'busy', 'away', 'dnd' (do not disturb)
  statusMessage String?   // Custom status message
  updatedAt     DateTime  @updatedAt

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ==================== JOB SEARCH ====================

// Job Search criteria - each represents a distinct search configuration
model JobSearch {
  id              String    @id @default(cuid())
  userId          String
  name            String    // Friendly name for this search (e.g., "Senior React Remote")
  keywords        String[]  // Search keywords (e.g., ["React", "TypeScript", "Senior"])
  locations       String[]  // Location filters (e.g., ["Toronto, ON", "Remote", "New York, NY"])
  remote          String    @default("any")  // 'any', 'remote', 'hybrid', 'onsite'
  salaryMin       Int?      // Minimum salary
  salaryMax       Int?      // Maximum salary
  salaryPeriod    String    @default("yearly")  // 'yearly', 'monthly', 'hourly'
  experienceLevel String?   // 'entry', 'mid', 'senior', 'lead', 'executive'
  jobTypes        String[]  @default(["fulltime"]) // 'fulltime', 'parttime', 'contract', 'internship'
  industry        String?   // Industry filter
  companySize     String?   // 'startup', 'small', 'medium', 'large', 'enterprise'
  excludeKeywords String[]  // Keywords to exclude from results
  sources         String[]  @default(["indeed", "linkedin"]) // Which sources to scrape
  isActive        Boolean   @default(true)
  lastScrapedAt   DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobs            Job[]

  @@index([userId])
  @@index([isActive])
}

// Resume uploads with metadata for AI matching
model Resume {
  id              String    @id @default(cuid())
  userId          String
  name            String    // Display name (e.g., "Full-Stack Resume 2026")
  fileName        String    // Original file name
  fileUrl         String    // URL/path to stored file
  fileSize        Int       // File size in bytes
  fileType        String    // MIME type (application/pdf, etc.)
  fileData        String?   @db.Text  // Base64-encoded file content
  
  // Metadata for AI matching
  targetRole      String?   // Target role this resume is optimized for
  targetIndustry  String?   // Industry this resume targets
  skills          String[]  // Key skills highlighted in this resume
  experienceYears Int?      // Years of experience reflected
  summary         String?   @db.Text  // Brief summary of the resume
  
  isDefault       Boolean   @default(false) // Default resume to use when none matches
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobApplications Job[]     @relation("JobResume")

  @@index([userId])
}

// Individual job listings found by scraping
model Job {
  id              String    @id @default(cuid())
  jobSearchId     String
  userId          String
  
  // Core job info
  title           String
  company         String
  location        String?
  description     String?   @db.Text
  salaryMin       Int?
  salaryMax       Int?
  salaryPeriod    String?   // 'yearly', 'monthly', 'hourly'
  jobType         String?   // 'fulltime', 'parttime', 'contract', 'internship'
  remote          String?   // 'remote', 'hybrid', 'onsite'
  experienceLevel String?
  postedAt        DateTime?
  expiresAt       DateTime?
  
  // Source info
  source          String    // 'indeed', 'linkedin'
  sourceUrl       String    // Original listing URL
  sourceId        String?   // Platform-specific ID
  
  // Application tracking
  status          String    @default("new") // 'new', 'reviewed', 'saved', 'applied', 'interviewing', 'offered', 'rejected', 'withdrawn', 'hidden'
  appliedAt       DateTime?
  appliedWith     String?   // Resume ID used for application
  resumeId        String?   // FK to Resume used
  
  // AI Agent fields
  aiScore              Float?    // Legacy AI match score (0-100)
  searchMatchScore     Float?    // How well job matches search criteria (0-100)
  candidateMatchScore  Float?    // How well candidate matches job requirements (0-100)
  aiNotes              String?   @db.Text  // AI analysis notes
  aiScoredAt           DateTime? // When the AI last scored this job
  autoApply            Boolean   @default(false)  // Whether AI should auto-apply
  
  // User notes
  notes           String?   @db.Text
  isFavorite      Boolean   @default(false)
  
  scrapedAt       DateTime  @default(now())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  jobSearch       JobSearch @relation(fields: [jobSearchId], references: [id], onDelete: Cascade)
  resume          Resume?   @relation("JobResume", fields: [resumeId], references: [id], onDelete: SetNull)
  coverLetter     CoverLetter?
  jobApplication  JobApplication?

  @@unique([sourceUrl, userId])  // Don't store same job twice for same user
  @@index([jobSearchId])
  @@index([userId])
  @@index([status])
  @@index([aiScore])
  @@index([createdAt])
  @@index([source])
}

// AI-generated cover letters for job applications
model CoverLetter {
  id          String    @id @default(cuid())
  userId      String
  jobId       String    @unique
  
  content     String    @db.Text    // Generated cover letter text (Markdown)
  model       String                // LLM model used
  version     Int       @default(1) // Regeneration count
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  job         Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  
  @@index([userId])
}

// Automated job application tracking
model JobApplication {
  id              String    @id @default(cuid())
  userId          String
  jobId           String    @unique

  // Application status
  status          String    @default("pending")
  // "pending" | "in_progress" | "navigating" | "filling" | "submitting" | "submitted" | "failed" | "needs_review" | "cancelled"

  // Resume + cover letter used
  resumeId        String?
  coverLetterId   String?

  // Step tracking
  steps           String    @db.Text  // JSON: ApplicationStep[]
  currentStep     String?             // Current step description
  totalSteps      Int       @default(0)

  // Result
  confirmationId  String?
  errorMessage    String?   @db.Text
  lastScreenshot  String?   @db.Text  // Base64 of last screenshot

  // Timing
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  job             Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}
